{
  "name": "Beauty Bloom — confirmations, reminders & repeat visits",
  "nodes": [
    {
      "id": "13d83e14-41f7-41b2-93b4-13c4b9409f44",
      "name": "Every 20 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 160],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 20
            }
          ]
        }
      },
      "disabled": true
    },
    {
      "id": "e9871d1b-918f-4c87-89a9-cb15f68cc36a",
      "name": "Run test manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, -80],
      "parameters": {}
    },
    {
      "id": "5802270b-02b7-4131-aa71-2808b5a51554",
      "name": "Studio configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, -80],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "bb2fefe5-b3a3-487a-9045-3a0b94a5f27c",
              "name": "crmUrl",
              "value": "https://beauty-bloom-crm.angrymunir.chatgpt.site",
              "type": "string"
            },
            {
              "id": "da3df341-8a36-4f0e-a77a-ba0d51eb2371",
              "name": "fromEmail",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e9b26aeb-4cb9-4edc-9b73-72189389f212",
      "name": "Claim queued messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Studio configuration\").first().json.crmUrl + \"/api/integration/claim\" }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "id": "453aebd0-bb9e-43de-ae2d-6b0f37484c18",
      "name": "Split jobs",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 0],
      "parameters": {
        "fieldToSplitOut": "jobs",
        "options": {}
      }
    },
    {
      "id": "d1c5f6ff-99b6-4378-8abb-f126651904db",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 0],
      "parameters": {
        "fromEmail": "={{ $(\"Studio configuration\").first().json.fromEmail }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ \"[ТЕСТ Beauty Bloom] · \" + ($json.kind === \"reminder\" ? \"Напоминание о визите\" : $json.kind === \"rebook\" ? \"Будем рады новой встрече\" : \"Ваша запись\") }}",
        "emailFormat": "text",
        "text": "={{ $json.message }}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "8ba9dc5a-fb8a-4e48-8dfb-461b7ddaf9d9",
      "name": "Acknowledge success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, -120],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Studio configuration\").first().json.crmUrl + \"/api/integration/ack\" }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({id: $(\"Split jobs\").item.json.id, lease: $(\"Split jobs\").item.json.lease, success: true}) }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "id": "5d1e8399-c370-4ca2-b751-0fb618b6a436",
      "name": "Acknowledge failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Studio configuration\").first().json.crmUrl + \"/api/integration/ack\" }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({id: $(\"Split jobs\").item.json.id, lease: $(\"Split jobs\").item.json.lease, success: false, error: String($json.error?.message || $json.error || \"SMTP delivery failed\").slice(0,500)}) }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "id": "94eb253d-5930-4a83-8aa1-2758e70f64c6",
      "name": "Setup instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 330],
      "parameters": {
        "content": "## Проверка писем Beauty Bloom\n1. Studio configuration: crmUrl и подтверждённый fromEmail.\n2. Header Auth: Authorization = Bearer + пробел + CRM-токен; подключить к трём HTTP-узлам. Секреты сохраняются только в credentials n8n.\n3. Подключить SMTP к Send email. В CRM войти владельцем, включить тестовую очередь и создать запись на разрешённый email с согласием.\n4. Execute workflow: подтвердить получение в своём ящике. Напоминание/повторный визит можно ускорить в CRM кнопкой «Проверить сейчас».\nРасписание выключено. Для постоянной работы проверить тариф/лимит n8n и включить 20 минут: около 2160 запусков за 30 дней, больше лимита 1000 в пробном периоде.\nДемо-контакты не выдаются API. Максимум 5 попыток, резерв 10 минут. SMTP может дублировать письмо при сбое до ACK.",
        "height": 350,
        "width": 780
      }
    }
  ],
  "connections": {
    "Claim queued messages": {
      "main": [
        [
          {
            "node": "Split jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split jobs": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Acknowledge success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Acknowledge failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 20 minutes": {
      "main": [
        [
          {
            "node": "Studio configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run test manually": {
      "main": [
        [
          {
            "node": "Studio configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Studio configuration": {
      "main": [
        [
          {
            "node": "Claim queued messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Almaty"
  },
  "pinData": {},
  "tags": []
}
